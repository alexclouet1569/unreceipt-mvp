# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — SERVER ONLY. Never NEXT_PUBLIC_, never imported
# from a "use client" file. Used by /api/webhooks/stripe and /api/admin/*.
# Found in Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated allowlist of founder emails who can access /admin and
# /api/admin/*. Case-insensitive, surrounding whitespace tolerated.
# Example: alexandre@unreceipt.com,alex@example.com
CONCIERGE_ADMIN_EMAILS=

# Resend — sends the waitlist / welcome emails AND reads forwarded receipts
# (Receiving API), so it must be a FULL ACCESS key, not "sending access".
RESEND_API_KEY=re_your-api-key-here

# Resend Inbound — email forwarding intake at /api/intake/email.
# Signing secret of the `email.received` webhook (Resend Dashboard →
# Webhooks). `whsec_`-prefixed base64 secret in the Svix scheme. Server-only.
# Setting it also makes the welcome email mention the forwarding address.
RESEND_INBOUND_WEBHOOK_SECRET=whsec_your-inbound-secret-here

# The MX-bound subdomain that catches receipts+<hash>@... addresses.
# Defaults to in.unreceipt.com when unset; override in staging.
INBOUND_DOMAIN=in.unreceipt.com

# Shared concierge SMS/WhatsApp number rendered on the /app empty state.
# Step 7 will land the Twilio inbound handler that actually receives
# messages at this number. Leaving this unset (no key, or empty string)
# is fine — the empty state degrades to email-only.
NEXT_PUBLIC_INTAKE_SMS_NUMBER=

# Anthropic API key — SERVER ONLY. Used by /api/ocr to auto-extract receipt
# fields from photos via Claude vision. Never NEXT_PUBLIC_, never imported
# from a "use client" file. Found at https://console.anthropic.com →
# Settings → API Keys. Free $5 credit covers thousands of OCR calls.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Stripe (REQUIRED: secret key, webhook secret and the three plan prices)
# STRIPE_PRICE_ID (the old single price from before the three plans) is not
# read by any code any more: leave it out, and delete it from Vercel and
# .env.local if it is still there. Checkout never falls back to it.
# Server-side only:
STRIPE_SECRET_KEY=sk_test_or_sk_live_here
# whsec_ from `stripe listen` locally; from the Webhooks endpoint config in the
# Stripe Dashboard for prod. The local and prod values are different secrets.
STRIPE_WEBHOOK_SECRET=whsec_here
# One recurring monthly EUR price per plan, for the whole company (see
# src/lib/plans.ts). Stripe Dashboard → Products → UnReceipt Light /
# Regular / Heavy → copy each price_... id.
# Light €5.99/month, Regular €14.99/month, Heavy €29.99/month (excl. VAT).
STRIPE_PRICE_LIGHT=price_here
STRIPE_PRICE_REGULAR=price_here
STRIPE_PRICE_HEAVY=price_here
# Extra receipts above a plan's allowance (€0.40 each, excl. VAT). A Stripe
# Billing Meter with event name STRIPE_METER_EVENT_NAME (sum of values,
# customer mapped by stripe_customer_id) plus a metered monthly price on
# that meter. Leave both unset to show allowances without charging extras.
STRIPE_METER_EVENT_NAME=extra_receipt
STRIPE_PRICE_OVERAGE=price_here
# Browser-safe — used by future Stripe.js Elements work, not by Checkout itself.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_here

# Operational toggle: free pilot mode. Set to "true" to bypass the Stripe
# subscription gate at /app and show a "free pilot" banner. Used while the
# founder completes business registration / Stripe Live verification. Strict
# string compare — anything except literal "true" is paid mode.
PILOT_MODE=false

# Canonical product host. Marketing lives on the apex (unreceipt.com);
# the product (/app, /admin, /auth, /subscribe, /api/checkout, /api/billing,
# /api/webhooks, /api/admin) lives on app.unreceipt.com. Used by
# lib/app-url.ts to build cross-host CTAs, by /api/checkout to set Stripe
# success/cancel URLs and by /api/billing/portal for the customer portal's
# return link (falls back to https://app.unreceipt.com when unset).
# Leave unset locally — same-origin in dev — and set on Vercel for both
# Production AND Preview environments.
NEXT_PUBLIC_APP_URL=https://app.unreceipt.com

# Sentry error monitoring. Leave unset to disable (the SDK is a no-op).
# Create the project in Sentry's EU region so error data stays in the EU.
# A DSN is public by design (it only allows sending events), hence
# NEXT_PUBLIC_. Events are scrubbed of bodies, cookies, headers and query
# strings in src/lib/sentry-options.ts.
NEXT_PUBLIC_SENTRY_DSN=

# Scheduled jobs (vercel.json "crons"): exports clean-up, retention after
# cancellation, extra-receipt retry. Vercel sends this as
# "Authorization: Bearer <CRON_SECRET>" when the variable exists on the
# project. Any random string of 16+ characters. Without it the cron routes
# refuse every call, so nothing runs.
CRON_SECRET=

# Connected mailboxes ("Connect Gmail" / "Connect Outlook", src/lib/mailboxes/).
# Server-only, never NEXT_PUBLIC_. Without MAILBOX_TOKEN_KEY no provider can
# be connected (the connect routes answer 404).
# MAILBOX_TOKEN_KEY: AES-256-GCM key for the stored refresh tokens, 32 bytes
# base64. Generate with `openssl rand -base64 32`. Changing it makes every
# stored token unreadable (users must connect again): keep it stable and
# separate per environment.
MAILBOX_TOKEN_KEY=
# MAILBOX_STATE_SECRET: HMAC key for the iPhone app's one-time connect links,
# at least 32 characters. Generate with `openssl rand -base64 32`.
MAILBOX_STATE_SECRET=
# OAuth redirect URIs to register: <NEXT_PUBLIC_APP_URL>/api/mailboxes/callback/google
# and …/callback/microsoft (locally set NEXT_PUBLIC_APP_URL=http://localhost:3000).
# Google Cloud: OAuth client (Web application), scope gmail.readonly.
# Gmail can be connected only when the client id, secret and topic are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Gmail push: Pub/Sub topic, full name projects/<project-id>/topics/<topic>,
# with gmail-api-push@system.gserviceaccount.com as Pub/Sub Publisher on it.
GOOGLE_PUBSUB_TOPIC=
# The topic's push subscription: endpoint
# https://app.unreceipt.com/api/mailboxes/push/google, authentication on,
# signed as a service account of the project (that account's email below),
# audience below (any string; the endpoint URL is the usual choice).
# /api/mailboxes/push/google refuses every push while either is unset.
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_SA_EMAIL=
# Microsoft Entra app registration (portal.azure.com → Microsoft Entra ID →
# App registrations): supported account types "Accounts in any
# organizational directory and personal Microsoft accounts", Web redirect
# URI <NEXT_PUBLIC_APP_URL>/api/mailboxes/callback/microsoft, delegated
# Microsoft Graph permissions Mail.Read, User.Read, offline_access, openid,
# email. Outlook can be connected only when all three values below are set.
# MS_OAUTH_CLIENT_ID: the registration's "Application (client) ID".
MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET: Certificates & secrets → New client secret, the
# secret's Value (not its ID). It expires (24 months at most): renew it
# before then, or every Outlook connection stops syncing (Sentry reports
# "client_invalid").
MS_OAUTH_CLIENT_SECRET=
# MS_GRAPH_CLIENT_STATE: random string (16–128 characters) Graph echoes in
# every change notification; /api/mailboxes/push/microsoft drops any
# notification without it. Generate with `openssl rand -hex 32`. Keep it
# stable: a subscription keeps the value it was created with (renewals don't
# change it), so after a change its notifications are dropped and new mail
# arrives only through the daily catch-up until the user reconnects.
# Push needs a public https notification URL: locally, Outlook connects
# but new mail arrives only through the daily job (or use a tunnel as
# NEXT_PUBLIC_APP_URL).
MS_GRAPH_CLIENT_STATE=
